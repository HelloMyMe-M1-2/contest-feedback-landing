# 실제 분석 도구, 인증 정보, 이메일 저장소는 아직 연결하지 않았습니다.
# VITE_로 시작하는 값은 브라우저에 공개됩니다. 비밀 키를 넣지 마세요.
# PostHog 프로젝트의 공개 수집 토큰만 사용합니다. 개인 API 키는 넣지 마세요.
# 개발자 로컬·배포 화면 테스트용입니다. 기본적으로 참가자에게 전송하지 않습니다.
VITE_POSTHOG_TEST_TOKEN=
VITE_POSTHOG_TEST_HOST=
# 배포된 테스트 주소에서 개발자 테스트를 허용할 때만 true. 기본값은 비활성.
VITE_POSTHOG_PREVIEW_ENABLED=false
